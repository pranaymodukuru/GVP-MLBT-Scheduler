# Copy this to .env for local configuration.
# Leave APP_PASSWORD unset (or empty) for open access during local dev.

APP_PASSWORD=your_password_here

# Optional: override where schedules are saved (default: ./saved_schedules)
# On Railway: Nixpacks deploys to /app, so the default resolves to /app/saved_schedules.
# Mount your Railway Volume at /app/saved_schedules — no need to set this var.
# SAVE_DIR=/app/saved_schedules
